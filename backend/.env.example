# --- Required -------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/holydo_market"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4001
# Set to 1 only when a reverse proxy (Render, Nginx…) sits in front of the API.
TRUST_PROXY=""

# Public URL of the website: used in email links, and (in production) the only
# origin allowed to call the API. Several origins: comma-separated.
FRONTEND_URL="http://localhost:4000"
APP_URL="http://localhost:4000"

# --- Email (optional in dev: without SMTP_URL, emails are printed in the console)
# Any SMTP provider works, e.g. Resend: smtps://resend:API_KEY@smtp.resend.com:465
SMTP_URL=""
MAIL_FROM="HOLYDO MARKET <no-reply@your-domain.com>"

# --- Photos (optional in dev: without it, photos are saved in ./uploads)
# Required on hosts with a temporary disk (Render, Railway…).
CLOUDINARY_URL=""

# --- Address search (optional) -------------------------------------------
# Photon / OpenStreetMap geocoder. Results are favoured around this point.
GEOCODER_URL="https://photon.komoot.io/api/"
GEO_BIAS_LAT=45.52
GEO_BIAS_LNG=-73.6
