// =============================================================================
// HOLYDJO MARKET — Database schema (Prisma + PostgreSQL)
//
// Core idea:
//   User (customer | provider | admin)
//     └─ ProviderProfile (1:1, only for providers) — must be APPROVED by an admin
//          ├─ Service[]        what they sell, with price + duration + category
//          ├─ Photo[]          gallery
//          ├─ OpeningHours[]   one row per weekday
//          ├─ Review[]         left by customers
//          └─ AppointmentRequest[]  booking / contact requests from customers
//   ModerationLog keeps an audit trail of every admin decision.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

/// Independent person (freelance braider, handyman…) vs. registered business (salon, shop…)
enum ProviderKind {
  INDEPENDENT
  BUSINESS
}

/// Lifecycle of a provider profile. Only APPROVED profiles are visible in search.
enum ProfileStatus {
  DRAFT // being filled in, never submitted
  PENDING // submitted, waiting for an admin
  APPROVED // public
  REJECTED // admin refused, see rejectionReason; provider can fix and resubmit
}

enum AppointmentStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // bcrypt hash, never returned by the API
  firstName String
  lastName  String
  phone     String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// When the user accepted the terms of use + privacy policy at sign-up.
  termsAcceptedAt   DateTime?
  /// Tokens issued before this moment are rejected (set on password reset).
  passwordChangedAt DateTime?
  /// Set when the user clicked the link in the "confirm your email" message.
  /// Unverified accounts can browse but can't book, submit a profile, review or report.
  emailVerifiedAt   DateTime?

  providerProfile ProviderProfile?
  reviews         Review[]
  appointments    AppointmentRequest[] @relation("CustomerAppointments")
  moderations     ModerationLog[]
  resetTokens     PasswordResetToken[]
  verifyTokens    EmailVerificationToken[]
  proposedCategories Category[] @relation("ProposedCategories")
  reports            Report[]   @relation("Reports")
}

/// One-time "forgot password" links. Only a SHA-256 hash of the token is stored,
/// so a database leak can't be used to reset accounts.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// APPROVED categories are public (home tiles, search menu).
/// PENDING ones were proposed by a provider: usable by providers right away,
/// shown publicly only after an admin approves them.
enum CategoryStatus {
  APPROVED
  PENDING
}

model Category {
  id       String         @id @default(uuid())
  slug     String         @unique // "hair", "braids"… used in URLs
  name     String
  icon     String // emoji used in the UI; cheap and works everywhere
  order    Int            @default(0)
  status   CategoryStatus @default(APPROVED)
  services Service[]

  /// Provider who proposed it (null for the built-in categories).
  proposedById String?
  proposedBy   User?    @relation("ProposedCategories", fields: [proposedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([status])
}

model ProviderProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug        String       @unique // public URL: /p/<slug>
  kind        ProviderKind @default(INDEPENDENT)
  displayName String
  tagline     String?
  description String?
  phone       String?
  whatsapp    String?

  // --- Location ---------------------------------------------------------
  // We store a point (lat/lng) for distance search plus human-readable
  // city / neighbourhood for display and text search.
  address       String?
  neighbourhood String?
  city          String
  latitude      Float
  longitude     Float
  /// IANA time zone of the provider's location (e.g. "America/Vancouver"),
  /// derived from latitude/longitude. Appointment times are shown in it.
  timeZone      String?

  // --- Where the service happens ---------------------------------------
  // Several can be true at once (e.g. salon AND travels to client).
  atHome      Boolean @default(false) // provider receives clients at their own home
  inSalon     Boolean @default(false)
  inShop      Boolean @default(false)
  travels     Boolean @default(false) // provider goes to the client
  travelRadiusKm Int  @default(0) // only meaningful when travels = true

  // --- Moderation ---------------------------------------------------------
  status          ProfileStatus @default(DRAFT)
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectionReason String?

  // Denormalised rating so search can sort without aggregating every time.
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services     Service[]
  photos       Photo[]
  openingHours OpeningHours[]
  reviews      Review[]
  appointments AppointmentRequest[]
  moderation   ModerationLog[]

  @@index([status, city])
  @@index([latitude, longitude])
}

model Service {
  id          String          @id @default(uuid())
  profileId   String
  profile     ProviderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  priceCents  Int // store money as integer cents to avoid float errors
  priceFrom   Boolean @default(false) // displays "from $X" when price varies
  durationMin Int?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())

  appointments AppointmentRequest[]

  @@index([categoryId])
}

model Photo {
  id        String          @id @default(uuid())
  profileId String
  profile   ProviderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url       String // either /uploads/<file> or an absolute URL (seed data)
  isCover   Boolean @default(false)
  order     Int     @default(0)
  createdAt DateTime @default(now())
}

model OpeningHours {
  id        String          @id @default(uuid())
  profileId String
  profile   ProviderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  weekday   Int // 0 = Sunday … 6 = Saturday (same as JS Date.getDay())
  opensAt   String? // "09:00" — null when closed
  closesAt  String? // "18:00"
  closed    Boolean @default(false)

  @@unique([profileId, weekday])
}

model Review {
  id         String          @id @default(uuid())
  profileId  String
  profile    ProviderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  authorId   String
  author     User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rating     Int // 1..5
  comment    String?
  createdAt  DateTime        @default(now())

  @@unique([profileId, authorId]) // one review per customer per provider
}

model AppointmentRequest {
  id          String            @id @default(uuid())
  profileId   String
  profile     ProviderProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  customerId  String
  customer    User              @relation("CustomerAppointments", fields: [customerId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  requestedAt DateTime // desired date/time
  location    String? // address when the provider travels to the client
  message     String?
  status      AppointmentStatus @default(PENDING)
  providerNote String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ModerationLog {
  id        String          @id @default(uuid())
  profileId String
  profile   ProviderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  adminId   String
  admin     User            @relation(fields: [adminId], references: [id])
  action    ProfileStatus // APPROVED or REJECTED
  reason    String?
  createdAt DateTime        @default(now())
}

// -----------------------------------------------------------------------------
// Email outbox: every email is stored first, then sent by a background worker
// with retries. Nothing is lost if the server restarts or the provider fails.
// -----------------------------------------------------------------------------
enum EmailStatus {
  PENDING // waiting to be sent (or to be retried)
  SENDING // claimed by the worker
  SENT
  FAILED // gave up after the last retry
}

model EmailOutbox {
  id            String      @id @default(uuid())
  to            String[]
  subject       String
  html          String
  text          String
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  lastError     String?
  nextAttemptAt DateTime    @default(now())
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Reports ("Signaler") on a profile or a review, reviewed by admins.
// -----------------------------------------------------------------------------
enum ReportTarget {
  PROFILE
  REVIEW
}

enum ReportStatus {
  OPEN
  RESOLVED
}

model Report {
  id         String       @id @default(uuid())
  targetType ReportTarget
  targetId   String // ProviderProfile.id or Review.id (no FK: the target may be deleted)
  reason     String // short code: fake, offensive, scam, wrong_info, other
  message    String?
  reporterId String?
  reporter   User?        @relation("Reports", fields: [reporterId], references: [id], onDelete: SetNull)
  status     ReportStatus @default(OPEN)
  adminNote  String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

/// One-time "confirm your email" links (only the SHA-256 hash is stored).
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Failed login attempts, used to slow down password guessing per account
/// and per IP without blocking people who log in successfully from a shared Wi-Fi.
/// Stored in the database so restarts don't reset the counters.
model LoginFailure {
  id        String   @id @default(uuid())
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}
